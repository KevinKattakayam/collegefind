# ---- Database -------------------------------------------------------------
# Pooled connection used at runtime.
DATABASE_URL="postgresql://user:password@host:5432/collegefind?sslmode=require"
# Direct (non-pooled) connection used by `prisma migrate`. On Neon these differ.
DIRECT_URL="postgresql://user:password@host:5432/collegefind?sslmode=require"

# ---- Auth -----------------------------------------------------------------
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET="replace-me-with-at-least-32-random-characters"
NEXTAUTH_URL="http://localhost:3000"

# ---- Site -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Set to "off" once every visible number comes from a cited source.
NEXT_PUBLIC_DATA_NOTICE="demo"

# ---- Rate limiting (optional, strongly recommended in production) ----------
# Without these, limits are per-instance only and weak on serverless.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---- HTTP seeding (optional, off by default) ------------------------------
# Prefer `npm run db:seed` from your own machine.
SEED_ENABLED="false"
SEED_ALLOW_PRODUCTION="false"
ADMIN_SEED_TOKEN=""

# ---- Tests ----------------------------------------------------------------
# Integration tests TRUNCATE tables. Never point this at a real database.
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/collegefind_test"
