// CollegeFind data model.
//
// Design rules (see docs/DATA_SOURCES.md):
// 1. Every number a student might act on (fees, cutoffs, placements, rankings)
//    lives in a *Record table with a year and a Source row. No anonymous numbers.
// 2. College keeps a small set of denormalised "summary" columns so listing and
//    filtering stay a single indexed query. Ingestion scripts own these columns;
//    they are nullable because "unknown" is a valid, honest answer.
// 3. College.dataStatus tells the UI how much to trust a row. DEMO rows must be
//    labelled as such everywhere they are shown.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CollegeType {
  GOVERNMENT
  PRIVATE
}

enum DataStatus {
  DEMO // invented values for development/demo only. Never present as fact.
  UNVERIFIED // imported but not yet checked against the source
  VERIFIED // checked against a Source row by a person
}

enum Role {
  USER
  ADMIN
}

enum ModerationStatus {
  VISIBLE
  HIDDEN
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Exam {
  JEE_MAIN
  JEE_ADVANCED
  NEET
  CAT
  GATE
}

// How a cutoff value is expressed. RANK: lower is better. PERCENTILE/SCORE: higher is better.
enum CutoffMetric {
  RANK
  PERCENTILE
  SCORE
}

// Seat categories as published by JoSAA/MCC. PwD is a separate flag.
enum SeatCategory {
  OPEN
  EWS
  OBC_NCL
  SC
  ST
}

enum SeatPool {
  GENDER_NEUTRAL
  FEMALE_ONLY
}

enum CounsellingSystem {
  UNSPECIFIED
  JOSAA
  CSAB
  MCC
  STATE
  OTHER
}

enum CutoffRankType {
  UNSPECIFIED
  CRL
  CATEGORY
  PWD_CATEGORY
  MERIT
}

model College {
  id              String      @id @default(cuid())
  slug            String      @unique
  name            String
  shortName       String
  city            String
  state           String
  type            CollegeType
  establishedYear Int?
  totalStudents   Int?
  naacGrade       String?

  // Summary columns maintained by ingestion. Nullable = unknown.
  annualFees     Int?
  placementPct   Int?
  avgPackage     Float?
  highestPackage Float?
  metricsYear    Int? // academic year the summary numbers describe

  topRecruiters String[] @default([])
  courses       String[] @default([])
  description   String?
  about         String?

  // Contact details are only stored when copied from an official source.
  website String?
  phone   String?
  email   String?

  // Computed from APPROVED reviews only. Null until real reviews exist.
  rating      Float?
  reviewCount Int    @default(0)

  dataStatus DataStatus @default(UNVERIFIED)
  aisheCode  String?    @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aliases          InstitutionAlias[]
  evidence         FieldEvidence[]
  savedBy          SavedCollege[]
  planChoices      PlanChoice[]
  planApplications PlanApplication[]
  planTasks        PlanTask[]
  questions        Question[]
  programs         Program[]
  feesRecords      FeesRecord[]
  placementRecords PlacementRecord[]
  nirfRankings     NirfRanking[]
  reviews          Review[]

  @@index([state])
  @@index([type])
  @@index([rating])
  @@index([annualFees])
  @@index([name])
}

model Program {
  id            String   @id @default(cuid())
  collegeId     String
  // Exact program name as published by the counselling authority, e.g.
  // "Computer Science and Engineering (4 Years, Bachelor of Technology)".
  name          String
  degree        String?
  branch        String?
  durationYears Float?
  createdAt     DateTime @default(now())

  college          College           @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  cutoffs          CutoffRecord[]
  feesRecords      FeesRecord[]
  placementRecords PlacementRecord[]
  planChoices      PlanChoice[]

  @@unique([collegeId, name])
  @@index([collegeId])
  @@index([branch])
}

model Source {
  identityKey String?         @unique
  publishedAt DateTime?
  evidence    FieldEvidence[]
  importRuns  ImportRun[]

  id          String   @id @default(cuid())
  name        String // e.g. "JoSAA 2025 Opening & Closing Ranks, Round 6"
  publisher   String // e.g. "Joint Seat Allocation Authority"
  url         String
  license     String? // e.g. "GODL-India" or "Terms not verified"
  retrievedAt DateTime
  notes       String?
  createdAt   DateTime @default(now())

  cutoffs          CutoffRecord[]
  feesRecords      FeesRecord[]
  placementRecords PlacementRecord[]
  nirfRankings     NirfRanking[]

  @@index([publisher])
}

model CutoffRecord {
  decisions         EvidenceDecision[]
  id                String             @id @default(cuid())
  programId         String
  exam              Exam
  counsellingSystem CounsellingSystem  @default(UNSPECIFIED)
  rankType          CutoffRankType     @default(UNSPECIFIED)
  year              Int
  round             Int
  quota             String // JoSAA: AI, HS, OS, GO, JK, LA. MCC: published quota name.
  category          SeatCategory
  isPwd             Boolean            @default(false)
  seatPool          SeatPool
  metric            CutoffMetric       @default(RANK)
  openingValue      Float?
  closingValue      Float
  isPreparatory     Boolean            @default(false) // JoSAA 'P' suffix
  evidenceLocator   String? // Imported table row or document page/table reference; never treated as a human review.
  sourceId          String
  createdAt         DateTime           @default(now())

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  source  Source  @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([programId, exam, year, round, quota, category, counsellingSystem, isPwd, seatPool], name: "naturalKey", map: "CutoffRecord_natural_key")
  @@index([exam, category, seatPool, year])
  @@index([programId])
  @@index([sourceId])
}

model FeesRecord {
  decisions EvidenceDecision[]
  id        String             @id @default(cuid())
  collegeId String
  programId String?
  year      Int
  amountInr Int
  feeType   String // e.g. "TUITION_PER_YEAR", "TOTAL_FIRST_YEAR"
  notes     String?
  sourceId  String
  createdAt DateTime           @default(now())

  college College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  program Program? @relation(fields: [programId], references: [id], onDelete: Cascade)
  source  Source   @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([collegeId, year])
  @@index([programId])
  @@index([sourceId])
}

model PlacementRecord {
  decisions       EvidenceDecision[]
  id              String             @id @default(cuid())
  collegeId       String
  programId       String?
  year            Int
  graduating      Int?
  placed          Int?
  medianSalaryInr Int?
  sourceId        String
  createdAt       DateTime           @default(now())

  college College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  program Program? @relation(fields: [programId], references: [id], onDelete: Cascade)
  source  Source   @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([collegeId, year])
  @@index([programId])
  @@index([sourceId])
}

model NirfRanking {
  decisions EvidenceDecision[]
  id        String             @id @default(cuid())
  collegeId String
  year      Int
  category  String // NIRF category name, e.g. "Overall", "Engineering"
  rank      Int
  score     Float?
  sourceId  String
  createdAt DateTime           @default(now())

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  source  Source  @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([collegeId, year, category])
  @@index([year, category, rank])
  @@index([sourceId])
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  role          Role      @default(USER)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  deactivatedAt DateTime?
  timeZone      String?

  evidenceDecisions EvidenceDecision[]
  saved             SavedCollege[]
  comparisons       SavedComparison[]
  questions         Question[]
  answers           Answer[]
  reviews           Review[]
  auditLogs         AuditLog[]
  admissionPlans    AdmissionPlan[]
  reportsMade       CommunityReport[]  @relation("ReportReporter")
  reportsResolved   CommunityReport[]  @relation("ReportResolver")
}

model SavedCollege {
  id        String   @id @default(cuid())
  userId    String
  collegeId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([userId, collegeId])
  @@index([userId])
  @@index([collegeId])
}

model SavedComparison {
  id         String   @id @default(cuid())
  userId     String
  signature  String
  collegeIds String[]
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, signature])
  @@index([userId])
}

model AdmissionPlan {
  id           String            @id @default(cuid())
  userId       String
  name         String
  cycle        String
  authority    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  choices      PlanChoice[]
  applications PlanApplication[]
  tasks        PlanTask[]

  @@unique([userId, name, cycle])
  @@index([userId, updatedAt(sort: Desc), id])
}

model PlanChoice {
  id              String           @id @default(cuid())
  planId          String
  collegeId       String?
  programId       String?
  cycle           String
  label           String
  position        Int
  note            String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  plan            AdmissionPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  college         College?         @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  program         Program?         @relation(fields: [programId], references: [id], onDelete: SetNull)
  planApplication PlanApplication?

  @@unique([planId, cycle, label])
  @@unique([planId, position])
  @@index([planId, cycle, position])
}

model PlanApplication {
  id                 String        @id @default(cuid())
  planId             String
  choiceId           String?       @unique
  version            Int           @default(0)
  collegeId          String?
  institutionName    String?
  programName        String?
  counsellingDetails String?
  status             String        @default("INTERESTED")
  cycle              String
  submittedAt        DateTime?
  nextAction         String?
  note               String?
  reference          String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  plan               AdmissionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  choice             PlanChoice?   @relation(fields: [choiceId], references: [id], onDelete: SetNull)
  college            College?      @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  tasks              PlanTask[]

  @@index([planId, status, updatedAt(sort: Desc)])
  @@index([planId, collegeId, status])
}

model PlanTask {
  id            String           @id @default(cuid())
  planId        String
  applicationId String?
  collegeId     String?
  version       Int              @default(0)
  title         String
  description   String?
  kind          String
  dueAt         DateTime?
  timeZone      String
  completedAt   DateTime?
  note          String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  plan          AdmissionPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  application   PlanApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  college       College?         @relation(fields: [collegeId], references: [id], onDelete: SetNull)

  @@index([planId, completedAt, dueAt])
  @@index([planId, applicationId])
  @@index([planId, collegeId])
}

model Question {
  id          String            @id @default(cuid())
  text        String
  contentHash String?
  userId      String
  collegeId   String
  status      ModerationStatus  @default(VISIBLE)
  createdAt   DateTime          @default(now())
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  college     College           @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  answers     Answer[]
  reports     CommunityReport[]

  @@unique([userId, collegeId, contentHash])
  @@index([collegeId])
  @@index([collegeId, status, createdAt(sort: Desc), id])
  @@index([userId])
}

model Answer {
  id          String            @id @default(cuid())
  text        String
  contentHash String?
  userId      String
  questionId  String
  status      ModerationStatus  @default(VISIBLE)
  createdAt   DateTime          @default(now())
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  question    Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  reports     CommunityReport[]

  @@unique([userId, questionId, contentHash])
  @@index([questionId])
  @@index([questionId, status, createdAt, id])
  @@index([userId])
}

model CommunityReport {
  id               String    @id @default(cuid())
  reporterId       String
  questionId       String?
  answerId         String?
  reason           String
  status           String    @default("OPEN")
  resolutionReason String?
  resolvedAt       DateTime?
  resolvedById     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  reporter         User      @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  question         Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer           Answer?   @relation(fields: [answerId], references: [id], onDelete: Cascade)
  resolvedBy       User?     @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([reporterId, questionId])
  @@unique([reporterId, answerId])
  @@index([status, createdAt, id])
  @@index([questionId, status])
  @@index([answerId, status])
}

// Schema is ready; the submission UI is deliberately not shipped yet (see docs/ROADMAP.md).
model Review {
  id        String       @id @default(cuid())
  collegeId String
  userId    String
  rating    Int // 1..5, enforced in application validation
  text      String
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([collegeId, userId])
  @@index([collegeId, status])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String // e.g. "question.hide", "seed.run"
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId])
}

// Profile claims only; financial/admission values stay in their existing typed tables.
model FieldEvidence {
  isFixture         Boolean            @default(false)
  campusScope       String?
  applicablePeriod  String?
  publisherPeriod   String?
  historical        Boolean            @default(false)
  sourceReportedRef String?            @unique
  evidenceLocator   String?
  evidenceSnippet   String?
  publishedAt       DateTime?
  id                String             @id @default(cuid())
  collegeId         String
  field             String
  value             Json
  unit              String?
  programScope      String?
  academicYear      Int?
  validFrom         DateTime?
  validUntil        DateTime?
  sourceId          String
  identityKey       String             @unique
  supersedesId      String?
  createdAt         DateTime           @default(now())
  college           College            @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  source            Source             @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  supersedes        FieldEvidence?     @relation("EvidenceHistory", fields: [supersedesId], references: [id], onDelete: Restrict)
  successors        FieldEvidence[]    @relation("EvidenceHistory")
  decisions         EvidenceDecision[]

  @@index([collegeId, field])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
}

// Append-only decisions; no college-wide status promotion on import.
model EvidenceDecision {
  cutoffId    String?
  feesId      String?
  placementId String?
  rankingId   String?
  cutoff      CutoffRecord?    @relation(fields: [cutoffId], references: [id], onDelete: Restrict)
  fees        FeesRecord?      @relation(fields: [feesId], references: [id], onDelete: Restrict)
  placement   PlacementRecord? @relation(fields: [placementId], references: [id], onDelete: Restrict)
  ranking     NirfRanking?     @relation(fields: [rankingId], references: [id], onDelete: Restrict)
  id          String           @id @default(cuid())
  evidenceId  String?
  reviewerId  String
  status      ReviewStatus
  reason      String
  createdAt   DateTime         @default(now())
  evidence    FieldEvidence?   @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  reviewer    User             @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([evidenceId, createdAt])
  @@index([evidenceId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([cutoffId, createdAt(sort: Desc), id(sort: Desc)])
}

model ImportRun {
  id          String    @id @default(cuid())
  identityKey String    @unique
  checksum    String
  sourceId    String
  status      String    @default("STAGED")
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  summary     Json?
  issues      Json?
  source      Source    @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([status, startedAt])
}

// Alternate names are campus-scoped; codes are never guessed from names.
model InstitutionAlias {
  id         String    @id @default(cuid())
  collegeId  String
  namespace  String
  value      String
  campus     String
  validFrom  DateTime?
  validUntil DateTime?
  sourceUrl  String
  college    College   @relation(fields: [collegeId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([namespace, value, campus, collegeId])
  @@index([namespace, value])
}
